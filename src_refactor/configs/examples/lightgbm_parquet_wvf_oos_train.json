{
  "market": {
    "source": "parquet",
    "data_root": "_data",
    "exchange_code": "bybit",
    "symbols": ["BTC/USDT", "ETH/USDT"],
    "timeframe": "1h",
    "htf_timeframe": "4h"
  },
  "model": {
    "model_type": "lightgbm",
    "profile": "baseline"
  },
  "walk_forward": {
    "predictions_path": "models/predictions/lightgbm_wvf_oos.parquet",
    "split_mode": "monthly_expanding",
    "train_months": 6,
    "test_months": 1,
    "purge_gap": 24
  }
}
